{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Thermal Controller — Host Build vs QEMU",
  "uid": "embedded-sensor-build-qemu",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "description": "Left: host/container verification. Right: QEMU virtual target. Software cooling decisions are tested; electrical sensor/actuator I/O and physical HiL are not implemented.",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "thermal-control",
    "virtual-target",
    "test-quality"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Host build test pass rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "embedded_test_pass_rate_percent{job=\"embedded_sensor_pipeline\",target=\"host\"}",
          "legendFormat": "Build",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "percent",
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Latest published test snapshot; 100% means all reported tests passed. See result age. A test gate is not deployment or physical hardware health."
    },
    {
      "id": 2,
      "title": "Host build test gate (1=passed)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "embedded_test_gate_passed{job=\"embedded_sensor_pipeline\",target=\"host\"}",
          "legendFormat": "Build",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "BLOCKED",
                  "color": "red"
                },
                "1": {
                  "text": "PASSED",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Latest published test snapshot; 100% means all reported tests passed. See result age. A test gate is not deployment or physical hardware health."
    },
    {
      "id": 3,
      "title": "Host build result age — seconds",
