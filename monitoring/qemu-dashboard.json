      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - embedded_test_last_run_timestamp_seconds{job=\"embedded_sensor_pipeline\",target=\"host\"}",
          "legendFormat": "Build",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "s"
