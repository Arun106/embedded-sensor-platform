{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Thermal Controller — Module Verification",
  "uid": "embedded-sensor-modules",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Overall test pass rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "embedded_test_pass_rate_percent{job=\"embedded_sensor_pipeline\",target=~\"${result_target:regex}\"}",
          "instant": true,
          "format": "time_series",
          "legendFormat": "Selected result source"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "percent",
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "description": "Latest published test snapshot; 100% means all reported tests passed. See result age. A test gate is not deployment or physical hardware health."
    },
    {
      "id": 2,
      "title": "Test gate passed (1=yes)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "embedded_test_gate_passed{job=\"embedded_sensor_pipeline\",target=~\"${result_target:regex}\"}",
          "instant": true,
          "format": "time_series",
          "legendFormat": "Selected result source"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "BLOCKED",
                  "color": "red"
                },
                "1": {
                  "text": "PASSED",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "description": "Latest published test snapshot; 100% means all reported tests passed. See result age. A test gate is not deployment or physical hardware health."
    },
    {
      "id": 3,
      "title": "Module pass rates",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "embedded_module_pass_rate_percent{job=\"embedded_sensor_pipeline\",target=~\"${result_target:regex}\",module=~\"temperature_input|threshold_control|cooling_output|fault_diagnostics|firmware_identity\"}",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{module}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "percent",
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "description": "Latest published test snapshot; 100% means all reported tests passed. See result age. A test gate is not deployment or physical hardware health."
    },
    {
      "id": 4,
      "title": "Module test outcomes",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "embedded_test_cases{job=\"embedded_sensor_pipeline\",target=~\"${result_target:regex}\",module=~\"temperature_input|threshold_control|cooling_output|fault_diagnostics|firmware_identity\"}",
          "instant": true,
          "format": "table",
          "legendFormat": "{{module}} / {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "description": "Latest published test snapshot; 100% means all reported tests passed. See result age. A test gate is not deployment or physical hardware health."
    },
    {
      "id": 5,
      "title": "Tracked bugs by module and state",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "embedded_tracked_bugs{job=\"embedded_sensor_pipeline\",target=~\"${result_target:regex}\",module=~\"temperature_input|threshold_control|cooling_output|fault_diagnostics|firmware_identity\"}",
          "instant": true,
          "format": "table",
          "legendFormat": "{{module}} / {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "description": "Latest published test snapshot; 100% means all reported tests passed. See result age. A test gate is not deployment or physical hardware health."
    },
    {
      "id": 6,
      "title": "Age of last test run (seconds)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - embedded_test_last_run_timestamp_seconds{job=\"embedded_sensor_pipeline\",target=~\"${result_target:regex}\"}",
          "instant": true,
          "format": "time_series",
          "legendFormat": "Selected result source"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "description": "Latest published test snapshot; 100% means all reported tests passed. See result age. A test gate is not deployment or physical hardware health."
    },
    {
      "id": 90,
      "title": "Thermal control path and test scope",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 6
      },
      "options": {
        "mode": "markdown",
        "content": "**Temperature input → Threshold control → Cooling output (software request)**\n\n**Fault diagnostics** checks invalid input; **Firmware identity** checks the candidate version.\n\nNORMAL = no cooling request; OVERHEAT = cooling requested. No fan, relay, PWM or physical sensor I/O is driven. Host and QEMU are software verification layers; physical HiL is a future extension.\n\nA 100% pass rate means all tests in the selected snapshot passed. It is not a hardware-health or coverage score."
      }
    }
  ],
  "tags": [
    "thermal-control",
    "virtual-target",
    "test-quality"
  ],
  "description": "Select one result source. Temperature input, threshold control, software cooling output, diagnostics and firmware identity. QEMU is virtual-target verification, not physical HiL.",
  "templating": {
    "list": [
      {
        "name": "result_target",
        "label": "Result source",
        "type": "custom",
        "query": "Host build : host,QEMU target : qemu,Alert simulation : qemu-simulation",
        "current": {
          "selected": true,
          "text": "QEMU target",
          "value": "qemu"
        },
        "options": [
          {
            "text": "Host build",
            "value": "host",
            "selected": false
          },
          {
            "text": "QEMU target",
            "value": "qemu",
            "selected": true
          },
          {
            "text": "Alert simulation",
            "value": "qemu-simulation",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false
      }
    ]
  }
}
